# demo | development | production
APP_MODE=demo
PORT=3000
# >= 32 random chars in production:  openssl rand -base64 48
JWT_SECRET=
JWT_TTL=8h
CORS_ORIGINS=http://localhost:5173
# Supabase -> Project settings -> Database -> connection string (pooler URI on Render). Ignored in demo mode.
DATABASE_URL=
# 32-byte key for encrypting courier_credentials (openssl rand -base64 32)
CREDENTIAL_ENCRYPTION_KEY=
# Razorpay: leave empty to keep the simulated gateway. Use rzp_test_ keys until sign-off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
